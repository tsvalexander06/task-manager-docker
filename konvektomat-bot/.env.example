# ─────────────────────────────────────────────────────────────────────────────
# Telegram
# ─────────────────────────────────────────────────────────────────────────────
# Токен на бота от @BotFather
TELEGRAM_BOT_TOKEN=123456:ABC-DEF...

# Твоят личен Telegram chat ID (операторът, който одобрява драфтовете)
OPERATOR_CHAT_ID=8785668541

# ─────────────────────────────────────────────────────────────────────────────
# Claude (Anthropic)
# ─────────────────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# Модел на Claude — лесно сменяем. Препоръчани стойности:
#   claude-sonnet-4-6  (баланс цена/качество — добър избор за чат отговори)
#   claude-opus-4-8    (най-умен, по-скъп)
#   claude-haiku-4-5   (най-евтин/бърз, за прости отговори)
CLAUDE_MODEL=claude-sonnet-4-6

# Макс. брой токени в драфта (по желание)
CLAUDE_MAX_TOKENS=1024

# ─────────────────────────────────────────────────────────────────────────────
# WhatsApp Cloud API (Meta / graph.facebook.com)
# ─────────────────────────────────────────────────────────────────────────────
# Permanent или temporary access token от Meta App
WHATSAPP_TOKEN=EAAG...

# Phone Number ID (от WhatsApp > API Setup)
WHATSAPP_PHONE_NUMBER_ID=123456789012345

# Verify token — измисляш си произволен низ; същият се въвежда в Meta при
# конфигуриране на webhook-а
WHATSAPP_VERIFY_TOKEN=my-random-verify-token

# Версия на Graph API (по желание)
WHATSAPP_GRAPH_VERSION=v21.0

# ─────────────────────────────────────────────────────────────────────────────
# Сървър
# ─────────────────────────────────────────────────────────────────────────────
# Порт за Express (WhatsApp webhook). Railway/Render подават PORT автоматично.
PORT=3000

# Системен промпт за Claude. По избор: остави празно и редактирай
# src/system-prompt.md, ИЛИ постави целия промпт тук (има приоритет над файла).
SYSTEM_PROMPT=
